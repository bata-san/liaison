{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liaison",
  "version": "0.2.0",
  "identifier": "dev.batasan.liaison",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liaison",
        "width": 1380,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
